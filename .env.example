# ============================================================
#  OpenClaw Elite Mini M9 — Environment Variables
#  Copy this file to .env and fill in your keys
#  NEVER commit .env to GitHub
# ============================================================

# --- Anthropic (Claude fallback when Ollama is offline) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- OpenClaw Gateway ---
OPENCLAW_API_KEY=your_openclaw_key_here

# --- Open WebUI ---
WEBUI_SECRET_KEY=change-this-to-a-random-string

# --- AnythingLLM ---
JWT_SECRET=change-this-jwt-secret

# --- Finance API (optional, for TurboQuant) ---
FINANCE_API_KEY=

# --- Hardware (auto-set by docker-compose, override if needed) ---
CPU_CORES=4
MAX_MEMORY_GB=12
